# nginx example for api.classin.co.kr — ClassIn 학원 대시보드 (/dash)
#
# The app runs uvicorn with root_path=/dash (see .env: DASH_ROOT_PATH), so it
# generates its own links as /dash/... . The proxy must therefore STRIP the
# /dash/ prefix before forwarding to the app, which listens on / internally.
#
# IMPORTANT: /dash/webhook/classin (ClassIn Data Sub webhook receiver) must
# stay reachable over HTTPS with no auth/IP allowlist in front of it — the
# ClassIn server calls it directly, unauthenticated at the proxy layer,
# authenticated only via DASH_WEBHOOK_SAFEKEY at the application layer.
# Do not put this location behind basic auth, client-cert auth, or an IP
# allowlist, and do not rate-limit it aggressively.

server {
    listen 443 ssl http2;
    server_name api.classin.co.kr;

    # ssl_certificate     /etc/letsencrypt/live/api.classin.co.kr/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/api.classin.co.kr/privkey.pem;

    # --- ClassIn 학원 대시보드 (FastAPI, uvicorn root_path=/dash) ---
    location /dash/ {
        # Trailing slash on both sides: strips the /dash/ prefix before
        # forwarding, e.g. /dash/webhook/classin -> /webhook/classin.
        proxy_pass http://127.0.0.1:8100/;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # Cookies are marked Secure (DASH_COOKIE_SECURE=true); this location
        # must be served over HTTPS only for login sessions to work.
    }

    # Optional: redirect bare domain root or unrelated paths elsewhere,
    # or 404 — this file only documents the /dash/ location.

    # If other vhosts on this server use HTTP->HTTPS redirect, mirror that
    # here (a `listen 80` server block redirecting to https://$host$request_uri).
}


# =====================================================================
# webhook.classin.cloud — ClassIn Data Sub (웹훅) 수신 전용 호스트
# =====================================================================
#
# 등록 URL: https://webhook.classin.cloud/classin-api/webhook
#
# 대시보드(/dash)와 달리 이 위치는 프리픽스를 벗기지 않는다. 앱이
# root_path=/dash 로 떠 있어도 라우팅은 실제 요청 경로로 매칭되므로
# /classin-api/webhook 를 그대로 전달하면 된다.
#
# 이 위치 앞에 basic auth / client-cert / IP allowlist 를 두지 말 것.
# ClassIn 서버가 직접 호출하며, 인증은 애플리케이션 계층의
# DASH_WEBHOOK_SAFEKEY 검증으로 처리한다.
#
# 재전송 정책 주의: ClassIn 은 ACK 를 받을 때까지 10초 간격으로 무한
# 재시도하고, 그동안 뒤따르는 모든 이벤트가 밀린다(FIFO head-of-line).
# 따라서 이 위치는 공격적인 rate limit 을 걸지 말고, 502/504 가 나지
# 않도록 타임아웃을 넉넉히 둔다.

server {
    listen 443 ssl http2;
    server_name webhook.classin.cloud;

    # ssl_certificate     /etc/letsencrypt/live/webhook.classin.cloud/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/webhook.classin.cloud/privkey.pem;

    # 등록된 경로 하나만 노출한다 (SID 당 엔드포인트 1개).
    location = /classin-api/webhook {
        # 경로를 보존해 전달 (뒤에 슬래시를 붙이지 않는다).
        proxy_pass http://127.0.0.1:8100/classin-api/webhook;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;

        # ClassIn 은 POST 만 보낸다. 그 외는 405.
        limit_except POST { deny all; }
    }

    # 그 외 경로는 노출하지 않는다.
    location / { return 404; }
}
