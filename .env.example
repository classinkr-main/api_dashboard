# ClassIn Dashboard — copy to .env and fill in. Never commit .env.

# Deployment
DASH_ROOT_PATH=/dash
DASH_PORT=8100
DASH_SECRET_KEY=            # long random string, e.g. `openssl rand -hex 32`
DASH_COOKIE_SECURE=true

# Auth: "credential" (login with SID/secret) or "fixed" (env SID/secret + access password)
DASH_AUTH_MODE=credential
DASH_ACCESS_PASSWORD=       # required when DASH_AUTH_MODE=fixed

# ClassIn partner API (fixed mode / webhook)
DASH_CLASSIN_SID=
DASH_CLASSIN_SECRET=
DASH_CLASSIN_BASE_URL=https://api.eeo.cn
DASH_WEBHOOK_SAFEKEY=

# 실험 기능: 숙제 리마인드를 ClassIn 토론 활동으로 게시 (기본 꺼짐 — 실계정 검증 후 켜세요)
DASH_CLASSIN_APP_REMINDER=false

# Claude
DASH_ANTHROPIC_API_KEY=
DASH_ANTHROPIC_MODEL=claude-sonnet-5

# Storage
DASH_DATA_DIR=data
