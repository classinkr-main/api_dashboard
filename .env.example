# ClassIn Dashboard — copy to .env and fill in. Never commit .env.

# Deployment
DASH_ROOT_PATH=/dash
DASH_PORT=8100
DASH_SECRET_KEY=            # long random string, e.g. `openssl rand -hex 32`
DASH_COOKIE_SECURE=true

# Auth: "credential" (login with SID/secret) or "fixed" (env SID/secret + access password)
# 로그인 순서: 아이디+비밀번호(로컬 계정) → fixed 모드 접속 비밀번호 → credential 모드 SID/secret.
# 부트스트랩: 계정이 하나도 없을 때 아래 접속 비밀번호(또는 SID/secret)로 들어가면 owner 세션이 되고,
# /admin 에서 관(지점)과 계정(원장/관장/선생님)을 만들면 그때부터 각자 아이디로 로그인한다.
# 역할은 계정에 저장되며 로그인 화면에서 고를 수 없다 (ADR-0005). 관에 별도 ClassIn 계정이 있으면
# /admin 의 관 등록에서 SID/secret을 넣어 오버라이드한다.
DASH_AUTH_MODE=credential
DASH_ACCESS_PASSWORD=       # required when DASH_AUTH_MODE=fixed (owner bootstrap)

# ClassIn partner API (fixed mode / webhook)
DASH_CLASSIN_SID=
DASH_CLASSIN_SECRET=
DASH_CLASSIN_BASE_URL=https://api.eeo.cn
DASH_WEBHOOK_SAFEKEY=

# Claude
DASH_ANTHROPIC_API_KEY=
DASH_ANTHROPIC_MODEL=claude-sonnet-5

# Storage
DASH_DATA_DIR=data
